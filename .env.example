# ============================================================
# UniLibreTour — Variables de entorno de ejemplo
# Copia este archivo a `.env` y ajusta los valores si es necesario.
# NOTA: con Docker Compose estos valores se inyectan automáticamente;
# el `.env` solo hace falta para desarrollo local sin Docker.
# ============================================================

# Flask
FLASK_ENV=development
PORT=5000
HOST=0.0.0.0
SECRET_KEY=cambiar-por-un-secreto-seguro

# JWT
JWT_SECRET_KEY=cambiar-por-un-secreto-seguro

# Base de datos (local con Docker Compose)
# Formato: mysql+pymysql://<usuario>:<password>@<host>:<puerto>/<base_de_datos>
# Con Docker Compose el host es `db`; en local directo contra MySQL usa `localhost`.
DATABASE_URL=mysql+pymysql://unilibretour:unilibretour@localhost:3306/unilibretour_db

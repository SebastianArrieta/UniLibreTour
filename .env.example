# ============================================================
# UniLibreTour — Variables de entorno
# Copia este archivo a `.env` y completa TODOS los valores marcados.
# docker compose lee este .env automáticamente.
# ============================================================

# --- Aplicación ---------------------------------------------
# production en servidores; development solo en tu máquina.
FLASK_ENV=production
APP_PORT=5000

# Secretos largos y aleatorios (obligatorios en producción). Genera cada uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Cookies de sesión solo por HTTPS (1). Pon 0 únicamente si sirves por HTTP
# sin TLS (por ejemplo, pruebas locales).
JWT_COOKIE_SECURE=1

# --- Primer administrador -----------------------------------
# Se crea al arrancar SOLO si no existe ningún admin. Mínimo 8 caracteres.
# Tras el primer inicio puedes borrar ADMIN_PASSWORD de este archivo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador

# --- Base de datos (MySQL en docker compose) ----------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=unilibretour_db
MYSQL_USER=unilibretour
MYSQL_PASSWORD=
# Solo para ejecutar sin Docker (MySQL local):
# DATABASE_URL=mysql+pymysql://unilibretour:<password>@localhost:3306/unilibretour_db

# --- Correo (código 2FA) ------------------------------------
# Si MAIL_SERVER queda vacío, el segundo factor se omite (con aviso en el log)
# para no bloquear el acceso de los usuarios que lo tengan activo.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=1
MAIL_USE_SSL=0

# --- Solo desarrollo local ----------------------------------
# Con FLASK_ENV=development y OTP_DEV_ECHO=1 el código 2FA se muestra en
# pantalla. Nunca tiene efecto en producción.
OTP_DEV_ECHO=0
